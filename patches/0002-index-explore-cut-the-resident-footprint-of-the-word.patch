+        fn next(m: *MergedHits) ?WordHit {
+            while (m.bi < m.base.len and m.wi.isDeadBase(m.base[m.bi].doc_id)) m.bi += 1;
+            const has_base = m.bi < m.base.len;
+            if (m.di < m.delta.len and (!has_base or hitLessThan({}, m.delta[m.di], m.base[m.bi]))) {
