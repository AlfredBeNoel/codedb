+    try testing.expectEqual(@as(?c_int, null), inheritedLockFd(&.{"--lock-fd=x"}));
+    try testing.expectEqual(@as(?c_int, null), inheritedLockFd(&.{}));
+    try testing.expectEqual(@as(?u64, 0xab), spawnedKey(&.{ "--lock-fd=3", "--key=00000000000000ab" }));
